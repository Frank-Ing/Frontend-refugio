---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import Sidebar from '../../../components/layout/Sidebar.astro';
import Topbar from '../../../components/layout/Topbar.astro';
---
<DashboardLayout title="Editar animal · Refugio"><div class="flex min-h-screen"><Sidebar /><main class="min-w-0 flex-1"><Topbar title="Editar animal" /><div id="form-shell" class="p-6 lg:p-10"><p class="rounded-3xl bg-white p-8 text-sm text-ink/60">Cargando información...</p></div></main></div><script>import { api } from '../../../lib/api'; import { animalSchema } from '../../../features/animals/schemas'; import { getToken } from '../../../lib/session'; const shell=document.querySelector('#form-shell'); const id=Number(new URLSearchParams(location.search).get('id')); if(!getToken())location.href='/login'; const escapeHtml=(value:string)=>value.replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]??char)); const render=(a:any)=>{if(!shell)return;shell.innerHTML=`<form id="animal-form" class="max-w-2xl space-y-5 rounded-3xl bg-white p-6 lg:p-8" novalidate><div><p class="text-xs font-bold uppercase tracking-[.2em] text-teal">Ficha #${a.identificador}</p><h2 class="mt-2 font-display text-4xl text-teal-dark">Actualizar información</h2></div><label class="block text-sm font-medium">Nombre<input name="nombre" value="${escapeHtml(a.nombre)}" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"/><p data-error="nombre" class="text-xs text-red-600"></p></label><label class="block text-sm font-medium">Raza<input name="raza" value="${escapeHtml(a.raza)}" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"/><p data-error="raza" class="text-xs text-red-600"></p></label><div class="grid gap-5 sm:grid-cols-3"><label class="block text-sm font-medium">Edad<input name="edad" type="number" min="0" value="${a.edad}" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"/><p data-error="edad" class="text-xs text-red-600"></p></label><label class="block text-sm font-medium">Sexo<select name="sexo" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"><option ${a.sexo==='Hembra'?'selected':''}>Hembra</option><option ${a.sexo==='Macho'?'selected':''}>Macho</option></select></label><label class="block text-sm font-medium">Tipo<select name="tipoAnimal" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"><option ${a.tipoanimal==='Perro'?'selected':''}>Perro</option><option ${a.tipoanimal==='Gato'?'selected':''}>Gato</option></select></label></div><p id="form-error" class="hidden"></p><div class="flex gap-3"><a href="/dashboard/animals" class="rounded-full border border-ink/10 px-6 py-3 text-xs font-bold">CANCELAR</a><button class="rounded-full bg-yellow px-6 py-3 text-xs font-bold text-teal-dark">GUARDAR CAMBIOS</button></div></form>`;const form=document.querySelector<HTMLFormElement>('#animal-form');form?.addEventListener('submit',async(e)=>{e.preventDefault();const parsed=animalSchema.safeParse(Object.fromEntries(new FormData(form)));document.querySelectorAll('[data-error]').forEach(n=>n.textContent='');if(!parsed.success){parsed.error.issues.forEach(i=>{const n=document.querySelector(`[data-error="${String(i.path[0])}"]`);if(n)n.textContent=i.message});return}try{await api.updateAnimal(id,parsed.data);location.href='/dashboard/animals'}catch(error){const n=document.querySelector('#form-error');if(n){n.textContent=error instanceof Error?error.message:'No se pudo actualizar';n.className='rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700'}}})}; if(!id)location.href='/dashboard/animals'; else api.getAnimal(id).then(render).catch((error)=>{if(shell)shell.innerHTML=`<p class="rounded-3xl bg-white p-8 text-sm text-red-700">${error instanceof Error?escapeHtml(error.message):'No se pudo cargar el animal.'}</p>`});</script></DashboardLayout>
