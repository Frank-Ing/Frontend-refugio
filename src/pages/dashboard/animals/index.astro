---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import Sidebar from '../../../components/layout/Sidebar.astro';
import Topbar from '../../../components/layout/Topbar.astro';
---
<DashboardLayout title="Animales · Refugio"><div class="flex min-h-screen"><Sidebar /><main class="min-w-0 flex-1"><Topbar title="Nuestros animales" /><section class="p-6 lg:p-10"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-sm text-ink/60">Administra los registros del refugio.</p></div><a href="/dashboard/animals/nuevo" class="rounded-full bg-yellow px-6 py-3 text-center text-xs font-bold text-teal-dark hover:shadow-lg">+ REGISTRAR ANIMAL</a></div><form id="filters" class="mt-8 grid gap-3 rounded-3xl bg-white p-5 sm:grid-cols-2 lg:grid-cols-5"><input name="nombre" placeholder="Buscar por nombre" class="rounded-xl border border-ink/10 px-4 py-3 text-sm outline-none focus:border-teal" /><input name="raza" placeholder="Raza" class="rounded-xl border border-ink/10 px-4 py-3 text-sm outline-none focus:border-teal" /><select name="sexo" class="rounded-xl border border-ink/10 px-4 py-3 text-sm outline-none focus:border-teal"><option value="">Cualquier sexo</option><option>Hembra</option><option>Macho</option></select><select name="tipoAnimal" class="rounded-xl border border-ink/10 px-4 py-3 text-sm outline-none focus:border-teal"><option value="">Perros y gatos</option><option>Perro</option><option>Gato</option></select><button class="rounded-xl bg-teal px-4 py-3 text-sm font-semibold text-white hover:bg-teal-dark">FILTRAR</button></form><div id="notice" class="mt-5 hidden rounded-2xl px-4 py-3 text-sm"></div><div id="animal-list" class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3"><div class="rounded-3xl bg-white p-8 text-center text-sm text-ink/50">Cargando animales...</div></div></section></main></div><script>import { api, ApiError } from '../../../lib/api'; import { getToken } from '../../../lib/session'; const list=document.querySelector('#animal-list'); const filters=document.querySelector<HTMLFormElement>('#filters'); const notice=document.querySelector('#notice'); const showError=(message:string)=>{if(notice){notice.textContent=message;notice.className='mt-5 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700'}}; if(!getToken()) window.location.href='/login'; const load=async()=>{try{const params=new URLSearchParams(); if(filters) new FormData(filters).forEach((value,key)=>{if(value)params.set(key,String(value))}); const animals=await api.listAnimals(params.toString()); if(!list)return; list.innerHTML=animals.length?animals.map(a=>`<article class="rounded-3xl bg-white p-5 shadow-sm"><div class="flex items-start justify-between"><span class="grid size-12 place-items-center rounded-2xl ${a.tipoanimal==='Perro'?'bg-yellow':'bg-teal/10'} text-2xl">${a.tipoanimal==='Perro'?'🐶':'🐱'}</span><span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-teal">${a.tipoanimal}</span></div><h2 class="mt-5 font-display text-3xl text-teal-dark">${a.nombre}</h2><p class="mt-1 text-sm text-ink/60">${a.raza} · ${a.edad} años · ${a.sexo}</p><div class="mt-5 flex items-center justify-between border-t border-ink/10 pt-4"><span class="text-xs text-ink/50">Ingreso: ${a.fechaingreso}</span><a href="/dashboard/animals/editar?id=${a.identificador}" class="text-xs font-bold text-teal hover:underline">EDITAR</a></div></article>`).join(''):'<div class="rounded-3xl bg-white p-10 text-center text-sm text-ink/50 md:col-span-2 xl:col-span-3">No encontramos animales con esos filtros.</div>'}catch(error){if(error instanceof ApiError&&error.status===401)window.location.href='/login';else showError(error instanceof Error?error.message:'No se pudo cargar la información')}}; filters?.addEventListener('submit',(e)=>{e.preventDefault();load()}); load();</script></DashboardLayout>
