---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Topbar from '../../components/layout/Topbar.astro';
---
<DashboardLayout title="Resumen · Refugio"><div class="flex min-h-screen"><Sidebar /><main class="min-w-0 flex-1"><Topbar title="Buenos días" /><section class="p-6 lg:p-10"><div class="grid gap-5 md:grid-cols-3"><div class="rounded-3xl bg-teal p-6 text-white"><p class="text-sm text-white/70">Animales registrados</p><p id="total" class="mt-4 font-display text-6xl">—</p></div><div class="rounded-3xl bg-yellow p-6 text-teal-dark"><p class="text-sm">Compañeros esperando</p><p id="dogs" class="mt-4 font-display text-6xl">—</p></div><div class="rounded-3xl bg-white p-6"><p class="text-sm text-ink/60">Gatos en el refugio</p><p id="cats" class="mt-4 font-display text-6xl text-teal-dark">—</p></div></div><div class="mt-8 rounded-3xl bg-white p-8"><p class="text-xs font-bold uppercase tracking-[.2em] text-teal">Acción rápida</p><h2 class="mt-2 font-display text-4xl text-teal-dark">Cuida cada historia.</h2><p class="mt-2 text-sm text-ink/60">Mantén actualizada la información de todos nuestros animales.</p><a href="/dashboard/animals/nuevo" class="mt-6 inline-block rounded-full bg-teal px-6 py-3 text-xs font-bold text-white hover:bg-teal-dark">REGISTRAR ANIMAL</a></div></section></main></div><script>import { api } from '../../lib/api'; import { getToken, clearToken } from '../../lib/session'; const go = () => { if (!getToken()) window.location.href='/login'; }; go(); document.querySelectorAll('#logout-button,#mobile-logout').forEach((button) => button.addEventListener('click', async () => { try { await api.logout(); } finally { clearToken(); window.location.href='/login'; } })); api.listAnimals().then((animals) => { const set=(id:string,value:number)=>{const el=document.getElementById(id);if(el)el.textContent=String(value)}; set('total',animals.length); set('dogs',animals.filter(a=>a.tipoanimal==='Perro').length); set('cats',animals.filter(a=>a.tipoanimal==='Gato').length); }).catch(()=>{});</script></DashboardLayout>
