---
import PublicLayout from '../layouts/PublicLayout.astro';
import Logo from '../components/ui/Logo.astro';
import Notice from '../components/ui/Notice.astro';
---
<PublicLayout title="Iniciar sesión · Refugio">
  <main class="grid min-h-screen bg-cream lg:grid-cols-[.9fr_1.1fr]">
    <section class="relative hidden overflow-hidden bg-teal p-10 lg:block"><Logo /><div class="absolute -bottom-10 -left-10 size-72 rounded-full bg-yellow/90"></div><div class="relative z-10 mt-36 max-w-sm"><p class="text-sm font-semibold uppercase tracking-[.25em] text-yellow">Panel del refugio</p><h1 class="mt-4 font-display text-7xl leading-none text-white">Cada vida<br /><span class="text-yellow">importa.</span></h1><p class="mt-6 text-sm leading-7 text-white/70">Gestiona con cariño la información de nuestros animales.</p></div><div class="absolute bottom-12 right-12 text-8xl">🐾</div></section>
    <section class="flex items-center justify-center px-6 py-12"><div class="w-full max-w-md"><a href="/" class="mb-12 inline-flex items-center gap-2 font-semibold text-teal lg:hidden"><span class="grid size-9 place-items-center rounded-full bg-yellow">♡</span> Refugio.</a><p class="text-sm font-semibold uppercase tracking-[.2em] text-teal">Bienvenido de nuevo</p><h1 class="mt-3 font-display text-5xl text-teal-dark">Iniciar sesión</h1><p class="mt-3 text-sm text-ink/60">Accede al panel de administración del refugio.</p><form id="login-form" class="mt-9 space-y-5" novalidate><label class="block text-sm font-medium">Usuario<input name="usuario" autocomplete="username" class="mt-2 w-full rounded-2xl border border-ink/10 bg-white px-4 py-3 outline-none transition focus:border-teal focus:ring-4 focus:ring-teal/10" /></label><p data-error="usuario" class="-mt-3 text-xs text-red-600"></p><label class="block text-sm font-medium">Contraseña<input name="contrasena" type="password" autocomplete="current-password" class="mt-2 w-full rounded-2xl border border-ink/10 bg-white px-4 py-3 outline-none transition focus:border-teal focus:ring-4 focus:ring-teal/10" /></label><p data-error="contrasena" class="-mt-3 text-xs text-red-600"></p><Notice /><button class="w-full rounded-full bg-yellow px-6 py-4 text-sm font-bold text-teal-dark transition hover:-translate-y-0.5 hover:shadow-lg disabled:opacity-60" type="submit">ENTRAR AL PANEL</button></form><a href="/" class="mt-8 block text-center text-sm text-teal hover:underline">← Volver al inicio</a></div></section>
  </main>
  <script>
    import { loginSchema } from '../features/auth/schemas';
    import { api } from '../lib/api';
    import { saveToken } from '../lib/session';
    const form = document.querySelector<HTMLFormElement>('#login-form');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const parsed = loginSchema.safeParse(data);
      document.querySelectorAll('[data-error]').forEach((node) => node.textContent = '');
      if (!parsed.success) { parsed.error.issues.forEach((issue) => { const node = document.querySelector(`[data-error="${String(issue.path[0])}"]`); if (node) node.textContent = issue.message; }); return; }
      const button = form.querySelector('button'); if (button) button.disabled = true;
      try { const result = await api.login(parsed.data); saveToken(result.token); window.location.href = '/dashboard'; }
      catch (error) { const notice = document.querySelector('#notice'); if (notice) { notice.textContent = error instanceof Error ? error.message : 'No se pudo iniciar sesión'; notice.className = 'rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700'; } }
      finally { if (button) button.disabled = false; }
    });
  </script>
</PublicLayout>
