<section class="p-6 lg:p-10">
  <form id="animal-form" class="max-w-2xl space-y-5 rounded-3xl bg-white p-6 lg:p-8" novalidate>
    <div><p class="text-xs font-bold uppercase tracking-[.2em] text-teal">Nuevo registro</p><h2 class="mt-2 font-display text-4xl text-teal-dark">Cuéntanos sobre él.</h2><p class="mt-2 text-sm text-ink/60">Completa los datos para mantener su historia al día.</p></div>
    <label class="block text-sm font-medium">Nombre<input name="nombre" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal" placeholder="Ej. Max" /><p data-error="nombre" class="text-xs text-red-600"></p></label>
    <label class="block text-sm font-medium">Raza<input name="raza" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal" placeholder="Ej. Labrador" /><p data-error="raza" class="text-xs text-red-600"></p></label>
    <div class="grid gap-5 sm:grid-cols-3"><label class="block text-sm font-medium">Edad<input name="edad" type="number" min="0" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal" placeholder="0" /><p data-error="edad" class="text-xs text-red-600"></p></label><label class="block text-sm font-medium">Sexo<select name="sexo" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"><option value="Hembra">Hembra</option><option value="Macho">Macho</option></select></label><label class="block text-sm font-medium">Tipo<select name="tipoAnimal" class="mt-2 w-full rounded-2xl border border-ink/10 px-4 py-3 outline-none focus:border-teal"><option value="Perro">Perro</option><option value="Gato">Gato</option></select></label></div>
    <p id="form-error" class="hidden"></p><div class="flex gap-3"><a href="/dashboard/animals" class="rounded-full border border-ink/10 px-6 py-3 text-xs font-bold">CANCELAR</a><button type="submit" class="rounded-full bg-yellow px-6 py-3 text-xs font-bold text-teal-dark">GUARDAR ANIMAL</button></div>
  </form>
</section>
